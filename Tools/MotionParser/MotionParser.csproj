<Project Sdk="Microsoft.NET.Sdk">

  <!-- SP10-6: motion metadata parser (motlist.txt + .msa -> JSON).
       Mirrors the PC client's CRaceManager::__LoadRaceMotionList
       (GameLib/RaceManager.cpp:180-326) and CRaceMotionData::LoadMotionData
       (GameLib/RaceMotionData.cpp:309-472). Pure text parsing, no external
       dependencies; output JSON is the input of the Unity animation import. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>metin2-motionparser</AssemblyName>
    <RootNamespace>Metin2.Tools.MotionParser</RootNamespace>
  </PropertyGroup>

</Project>
