<Project Sdk="Microsoft.NET.Sdk">

  <!-- SP10-7: .sub (subtexture) sprite slicer CLI (docs/assets/asset-pipeline-research.md).
       Parses Metin2 UI .sub files — text-format sprite rectangles over atlas
       DDS/TGA images — and emits JSON for the Unity-side sprite slicing.
       Pure text parsing, no external dependencies; format ported from the
       client source (EterLib/GrpSubImage.cpp). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>metin2-subslicer</AssemblyName>
    <RootNamespace>Metin2.Tools.SubSlicer</RootNamespace>
  </PropertyGroup>

</Project>
