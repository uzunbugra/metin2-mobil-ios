<Project Sdk="Microsoft.NET.Sdk">

  <!-- SP10-1: EIX/EPK pack extractor CLI (docs/assets/asset-pipeline-research.md).
       Deliberate tool project — un-ignored via .gitignore negation
       (!Tools/**/*.csproj); Unity-generated csproj noise stays ignored.
       No external dependencies: TEA + LZO1X + CRC32 are source ports. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>metin2-packextractor</AssemblyName>
    <RootNamespace>Metin2.Tools.PackExtractor</RootNamespace>
  </PropertyGroup>

</Project>
